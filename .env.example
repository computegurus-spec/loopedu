# ==============================================================================
# LOOD-EDU / LOOPEDU ENVIRONMENT BLUEPRINT (.env.example)
# Blocks and Loops Technologies Pvt Ltd
# ==============================================================================

# 1. Application Mode & Regional Settings
APP_MODE=demo                      # 'demo' (synthetic personas, no keys required) | 'live'
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata

# 2. Database & Auth (Supabase PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY_HERE

# 3. AI Providers & Hard Cost Boundaries
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=nvidia
AI_DAILY_BUDGET_INR=500
AI_MONTHLY_BUDGET_INR=12000

# 4. Payment Gateway (Razorpay India)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
PAYMENTS_MODE=test
LIVE_PAYMENTS_ENABLED=false

# 5. Daily Briefing & Transactional Email
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_YOUR_KEY_HERE
EMAIL_FROM=briefing@loopedu.in
EMAIL_WEBHOOK_SECRET=YOUR_EMAIL_WEBHOOK_SECRET_HERE
EMAIL_SENDING_ENABLED=false

# 6. Operational Feature Flags & Safeguards
CRON_SECRET=YOUR_SECURE_CRON_BEARER_TOKEN
MINOR_ONBOARDING_ENABLED=false     # Kept adult-only until legal consent review
MINOR_COACH_ENABLED=false          # Kept off until clinical advisory sign-off
ADS_ENABLED=false                  # Controlled adult-only contextual cards (off by default)
