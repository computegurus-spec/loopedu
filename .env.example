# BoardEdge AI by itappens - Environment Configuration
# Copy this file to .env.local and fill in the required keys for production

# Application Environment
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pricing & Product Configuration
NEXT_PUBLIC_PRICE_PER_SUBJECT_INR=999
NEXT_PUBLIC_CURRENCY=INR
ACCESS_DURATION_DAYS=365
TAX_INCLUSIVE=true

# Razorpay Payment Gateway (Test Mode: rzp_test_... | Production: rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Supabase (PostgreSQL, Auth & Storage)
# In development, local file-backed private storage is used automatically if these are unset.
# In production, provide live Supabase project credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# Source Material Directory (for question bank import tool)
SOURCE_QUESTION_BANKS_DIR=C:\Users\sadis\Documents\Codex\2026-10-13\i-x20\outputs\CBSE_2027_Question_Banks

# Admin Access Controls (Comma-separated authorized admin emails)
ADMIN_EMAILS=founder@tinko.in,admin@itappens.ai
