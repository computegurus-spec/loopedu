# ==============================================================================
# LOOPEDU ENVIRONMENT BLUEPRINT (.env.example)
# Duplicate this file as .env.local for local development,
# or paste these environment variables into your Vercel Project Settings.
# ==============================================================================

# 1. Application URL
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Cloud Database (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# 3. Razorpay Payment Gateway (https://dashboard.razorpay.com/app/keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# 4. Product & Pricing
NEXT_PUBLIC_PRICE_PER_SUBJECT_INR=299
NEXT_PUBLIC_CURRENCY=INR
ACCESS_DURATION_DAYS=30
TAX_INCLUSIVE=true

# 5. AI Doubt Coach (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# 6. Admin Authorizations
ADMIN_EMAILS=sadish@loopedu.in,founder@tinko.in,admin@itappens.ai

# 7. Auth0 Authentication (https://manage.auth0.com)
AUTH0_SECRET=YOUR_32_BYTE_SECRET_HERE
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://dev-lyprc73sna08tv7e.us.auth0.com
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID_HERE
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET_HERE
